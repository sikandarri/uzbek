NODE_ENV=development
PORT=3001
DATABASE_URL=mongodb://127.0.0.1:27017/noldan_ravon?replicaSet=rs0&directConnection=true
# MongoDB Atlas alternative (use exact URI from Atlas, keep /noldan_ravon database):
# DATABASE_URL=mongodb+srv://DB_USER:URL_ENCODED_DB_PASSWORD@YOUR_CLUSTER.mongodb.net/noldan_ravon?retryWrites=true&w=majority
APP_ORIGIN=http://localhost:5173
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace_with_at_least_48_random_characters_generated_locally
TRUST_PROXY_HOPS=0
REGISTRATION_ENABLED=true
# Used only by the explicit development-only seed:demo command. Never set in production.
ALLOW_DEMO_SEED=false
DEMO_STUDENT_EMAIL=
DEMO_STUDENT_PASSWORD=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
# Reserved integrations for later phases. Not wired in Phase 1. Keep all secrets server-side.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
STT_PROVIDER=
STT_API_KEY=
TTS_PROVIDER=
TTS_API_KEY=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
MEDIA_BUCKET=
MEDIA_ENDPOINT=
MEDIA_ACCESS_KEY_ID=
MEDIA_SECRET_ACCESS_KEY=
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
